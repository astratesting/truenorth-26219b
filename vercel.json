{
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "frontend/dist" } },
    { "src": "backend/main.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/main.js" },
    { "src": "/(.*)", "dest": "/frontend/dist/$1" }
  ],
  "env": {
    "VITE_API_URL": "https://truenorth-api.vercel.app"
  }
}
